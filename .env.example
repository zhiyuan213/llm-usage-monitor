TENCENT_SES_NOTIFICATION_TEMPLATE=0
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_CORE_PRICE=
PADDLE_PRO_PRICE=
