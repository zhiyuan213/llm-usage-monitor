# Copy to .env, replace both secrets before starting.
APP_SECRET=replace-with-at-least-32-random-secret-characters
DATABASE_PASSWORD=replace-with-a-strong-database-password
SECURE_COOKIES=false
PUBLIC_URL=http://localhost:8088
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=noreply@metertrail.local
MAIL_PROVIDER=smtp
TENCENT_SES_REGION=ap-hongkong
TENCENT_SES_SECRET_ID=
TENCENT_SES_SECRET_KEY=
TENCENT_SES_VERIFICATION_TEMPLATE=0
TENCENT_SES_NOTIFICATION_TEMPLATE=0
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_CORE_PRICE=
PADDLE_PRO_PRICE=
PADDLE_API_URL=https://sandbox-api.paddle.com
GRAFANA_PASSWORD=replace-before-exposing-monitoring

# Enable only after sandbox collection acceptance.
USAGE_COLLECTION_ENABLED=false

# Ingest admission leaves DB connection headroom; raise only after capacity verification.
INGEST_MAX_INFLIGHT=4
# Consumer stays active while backlogged and backs off when idle or the DB is unavailable.
WORKER_BUSY_POLL_MS=10
WORKER_GROUP_BATCHES=100
WORKER_GROUP_EVENTS=500
WORKER_IDLE_POLL_MS=300
WORKER_SLICE_MS=250
WORKER_MAX_BATCHES_PER_SLICE=1000
WORKER_FAILURE_BACKOFF_MS=1000

# Two independent physical pools on the same primary PostgreSQL database.
DATABASE_WRITE_POOL_SIZE=8
DATABASE_READ_POOL_SIZE=8
DATABASE_WRITE_CONNECTION_TIMEOUT_MS=1000
DATABASE_READ_CONNECTION_TIMEOUT_MS=1000
# Persist/coalesce on API nodes; the dedicated downstream worker disables this pipeline.
INGEST_PIPELINE_ENABLED=true
INGEST_ACCEPTOR_ENABLED=true
INGEST_PIPELINE_MAX_INFLIGHT=2048
INGEST_PIPELINE_BUFFER_BYTES=33554432
INGEST_PIPELINE_BATCH_REQUESTS=200
INGEST_PIPELINE_GROUP_EVENTS=500
INGEST_PIPELINE_FLUSH_BYTES=2097152
INGEST_PIPELINE_COALESCE_MS=20
INGEST_PIPELINE_RECEIPT_POLL_MS=20
INGEST_PIPELINE_WAIT_MS=5000
INGEST_QUEUE_MAX_REQUESTS=20000
INGEST_QUEUE_MAX_EVENTS=50000
INGEST_QUEUE_MAX_BYTES=134217728
INGEST_QUEUE_MAX_ATTEMPTS=10
INGEST_QUEUE_RECEIPT_SECONDS=600
