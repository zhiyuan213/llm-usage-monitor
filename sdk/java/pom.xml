<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.metertrail</groupId>
  <artifactId>metertrail-sdk</artifactId>
  <version>0.1.0</version>
  <name>MeterTrail Java SDK</name>
  <description>MeterTrail source SDK for Java 17 and later</description>
  <url>https://github.com/zhiyuan213/llm-usage-monitor-sdk/tree/main/java</url>
  <scm>
    <connection>scm:git:https://github.com/zhiyuan213/llm-usage-monitor-sdk.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/zhiyuan213/llm-usage-monitor-sdk.git</developerConnection>
    <url>https://github.com/zhiyuan213/llm-usage-monitor-sdk</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub</system>
